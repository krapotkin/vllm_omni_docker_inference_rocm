# Конфигурация vLLM-Omni Docker (ROCm / AMD GPU)
# Копируйте в .env.local и настройте под себя

# Docker-образ
DOCKER_IMAGE=vllm-omni-rocm_v0_22_0:latest

# Порт на хосте (внутри контейнера всегда 8000)
PORT=8092

# Путь к модели на хосте
MODEL_HOST_PATH=/home/hermes/workspace/models/models_tts/Fun-CosyVoice3-0.5B-2512

# Путь к workspace на хосте (для ref_audio файлов)
WORKSPACE_PATH=/home/hermes/workspace

# Путь к ref_audio на хосте (монтируется как /ref_audio)
REF_AUDIO_PATH=/home/hermes/workspace/projects/vllm_omni_docker_inference_rocm/ref_audio

# GPU память (0.35 для APU с ограниченной видеопамятью)
GPU_MEMORY_UTILIZATION=0.35
